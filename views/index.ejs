<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WEB2 - Projekt 2</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main>
        <h1>WEB2 - Projekt 2</h1>
        <p>Demonstracija sigurnosnih ranjivosti</p>


    <section>
        <h2>1. SQL Injection</h2>

        <label>
            <input type="checkbox" id="sqlVulnerable" checked>
            Omogući SQL Injection ranjivost
        </label>

        <p>Pretraži bilješke prema korisničkom imenu:</p>

        <input type="text" id="sqlUsername" placeholder="Unesi korisničko ime">

        <button type="button" id="sqlButton">
            Pretraži
        </button>

        <h3>Izvršeni SQL upit:</h3>
        <pre id="sqlQuery"></pre>

        <h3>Rezultati:</h3>
        <div id="sqlResults"></div>
    </section>


    <section>
        <h2>2. Broken Authentication</h2>

        <label>
            <input type="checkbox" id="authVulnerable" checked>
            Omogući Broken Authentication ranjivost
        </label>

        <p>
            Unesi korisničko ime i PIN ili pokreni
            demonstraciju brute-force napada.
        </p>
        
        <div>
            <label for="authUsername">Korisničko ime:</label>
            <input type="text" id="authUsername" placeholder="Unesi username">
        </div>
        
        <div>
            <label for="authPin">PIN:</label>
            <input type="text" id="authPin" maxlength="4" inputmode="numeric" placeholder="Unesi PIN">
        </div>

        <div>
            <button type="button" id="authLoginButton">
                Prijavi se
            </button>

            <button type="button" id="authAttackButton">
                Pokreni napad
            </button>

            <button type="button" id="authResetButton">
                Resetiraj demonstraciju
            </button>
        </div>

        <h3>Status:</h3>
        <div id="authStatus"></div>

        <h3>Pokušaji prijave:</h3>
        <div id="authResults"></div>
    </section>

    </main>
    <script src="/script.js"></script>
</body>
</html>
